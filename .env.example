# ---------- Kraken (public market data needs no key; keys only for private endpoints) ----------
# If you create a key at https://pro.kraken.com/app/settings/api grant NO trading/withdraw rights.
KRAKEN_API_KEY=your_key_here
KRAKEN_SECRET_KEY=your_secret_here
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_PAIRS=XBTUSD,ETHUSD,SOLUSD
KRAKEN_MIN_INTERVAL_SECONDS=1.2
KRAKEN_MAX_PAGES_PER_RUN=5

# ---------- PostgreSQL (staging) ----------
# Use a URL-safe password (letters/digits/-_.~): it is embedded in the Airflow DB URL.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=crypto_pipeline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Kafka ----------
KAFKA_BOOTSTRAP=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_TOPIC_TRADES=crypto.trades.v1
KAFKA_TOPIC_DLQ=crypto.trades.dlq
PUBLISH_BATCH_SIZE=5000

# ---------- Cassandra (serving) ----------
CASSANDRA_HOST=cassandra
CASSANDRA_KEYSPACE=crypto

# ---------- Spark ----------
WATERMARK="10 minutes"
TRIGGER_INTERVAL="30 seconds"
SPARK_SHUFFLE_PARTITIONS=8
ANOMALY_RANGE_PCT=1.0
ANOMALY_VOLUME_Z=4.0
ANOMALY_MIN_TRADES=5

# ---------- Data-quality thresholds ----------
QUALITY_MAX_STALENESS_MIN=5
QUALITY_MAX_BACKLOG=50000
QUALITY_MAX_REJECT_RATE=0.01

# ---------- Airflow ----------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
