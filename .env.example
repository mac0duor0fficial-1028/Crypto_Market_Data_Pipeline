# Kraken (only needed for private endpoints; public market data needs no key)
KRAKEN_API_KEY=your_key_here
KRAKEN_SECRET_KEY=your_secret_here
KRAKEN_PAIRS=XBTUSD,ETHUSD,SOLUSD

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=crypto_pipeline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRADES=kraken.trades.v1

# Cassandra
CASSANDRA_HOST=cassandra
CASSANDRA_KEYSPACE=crypto